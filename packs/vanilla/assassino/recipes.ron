// The assassin class (crates/game/src/assassin.rs).
(
    shaped: [
        (pattern: [" I", "S "], key: {'I': "iron_ingot", 'S': "stick"}, result: "iron_dagger"),
        (pattern: [" I", "S "], key: {'I': "umbral_ingot", 'S': "stick"}, result: "umbral_dagger"),
        (pattern: [" I", "S "], key: {'I': "magmarite_ingot", 'S': "stick"}, result: "magmarite_dagger"),
        (pattern: [" I", "S "], key: {'I': "mythril_ingot", 'S': "stick"}, result: "mythril_dagger"),
        (pattern: [" I", "S "], key: {'I': "verdite_ingot", 'S': "stick"}, result: "verdite_dagger"),
        (pattern: [" I", "S "], key: {'I': "lumite_ingot", 'S': "stick"}, result: "lumite_dagger"),
        (pattern: ["W W", "WLW", "W W"], key: {'W': "black_wool", 'L': "leather"}, result: "shadow_cloak"),
        (pattern: ["K K", "KEK", "K K"], key: {'K': "throwing_knife", 'E': "warrior_emblem"}, result: "assassin_emblem"),
        (pattern: ["L L", "W W"], key: {'L': "leather", 'W': "white_wool"}, result: "silent_soles"),
        (pattern: ["LSL", "LKL"], key: {'L': "leather", 'S': "string", 'K': "throwing_knife"}, result: "throwing_glove"),
        (pattern: ["XYX", "X X"], key: {'X': "leather", 'Y': "jungle_spore"}, result: "nightshade_helmet"),
        (pattern: ["X X", "XYX", "XXX"], key: {'X': "leather", 'Y': "jungle_spore"}, result: "nightshade_chestplate"),
        (pattern: ["XYX", "X X", "X X"], key: {'X': "leather", 'Y': "jungle_spore"}, result: "nightshade_leggings"),
        (pattern: ["X X", "Y Y"], key: {'X': "leather", 'Y': "jungle_spore"}, result: "nightshade_boots"),
        (pattern: ["XYX", "X X"], key: {'X': "mythril_ingot", 'Y': "soul_of_night"}, result: "shroud_helmet"),
        (pattern: ["X X", "XYX", "XXX"], key: {'X': "mythril_ingot", 'Y': "soul_of_night"}, result: "shroud_chestplate"),
        (pattern: ["XYX", "X X", "X X"], key: {'X': "mythril_ingot", 'Y': "soul_of_night"}, result: "shroud_leggings"),
        (pattern: ["X X", "Y Y"], key: {'X': "mythril_ingot", 'Y': "soul_of_night"}, result: "shroud_boots"),
        (pattern: ["XYX", "X X"], key: {'X': "verdite_ingot", 'Y': "soul_of_night"}, result: "eclipse_helmet"),
        (pattern: ["X X", "XYX", "XXX"], key: {'X': "verdite_ingot", 'Y': "soul_of_night"}, result: "eclipse_chestplate"),
        (pattern: ["XYX", "X X", "X X"], key: {'X': "verdite_ingot", 'Y': "soul_of_night"}, result: "eclipse_leggings"),
        (pattern: ["X X", "Y Y"], key: {'X': "verdite_ingot", 'Y': "soul_of_night"}, result: "eclipse_boots"),
    ],
    shapeless: [
        (ingredients: ["coal", "gunpowder", "string"], result: "smoke_bomb", count: 4),
        (ingredients: ["glass_bottle", "jungle_spore", "spider_eye"], result: "poison_oil"),
        (ingredients: ["glass_bottle", "blaze_powder", "coal"], result: "fire_oil"),
        (ingredients: ["glass_bottle", "snowball", "snowball"], result: "frost_oil"),
        (ingredients: ["glass_bottle", "spider_fang", "soul_of_night"], result: "venom_oil"),
        (ingredients: ["shadow_cloak", "assassin_emblem", "soul_of_night", "soul_of_night", "soul_of_night"], result: "moonless_mark"),
    ],
)
